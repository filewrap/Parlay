# Telegram MTProto user session (get API credentials from https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Supply a Telethon session created by logging in separately. No interactive login here.
# An existing configured file wins. Otherwise one *.session in the working
# directory is discovered; multiple files require an explicit path.
# Docker Compose: put the file in ./data and set /app/data/<name>.session below.
TELEGRAM_SESSION=parlay.session
# Without a supplied file, use a Telethon StringSession from this variable.
# A valid Telethon StringSession in TELEGRAM_SESSION is also accepted.
# Other libraries' session strings are not interchangeable. Never share or log one.
TELEGRAM_STRING_SESSION=

# The Operator's own account. Numeric user id or @username.
# Commands from this identity and the logged-in account are accepted.
OPERATOR_ID=

# Google Gemini Live API key
GEMINI_API_KEY=

# PO-token provider (companion Docker service) base URL
POT_PROVIDER_URL=http://127.0.0.1:4416

# Command prefix
COMMAND_PREFIX=/

# Logging
LOG_LEVEL=INFO

# Local activity database, separate from Telegram authorization sessions.
# Docker Compose persists /app/data through the existing ./data mount.
ACTIVITY_DB_PATH=data/parlay.sqlite3
