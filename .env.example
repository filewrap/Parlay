# Telegram MTProto user session (get from https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Path to the Telethon session file (created on first login)
TELEGRAM_SESSION=parlay.session

# The Operator's own account. Numeric user id or @username.
# Only commands from this identity are acted on.
OPERATOR_ID=

# Google Gemini Live API key
GEMINI_API_KEY=

# PO-token provider (companion Docker service) base URL
POT_PROVIDER_URL=http://127.0.0.1:4416

# Command prefix
COMMAND_PREFIX=/

# Logging
LOG_LEVEL=INFO
