# Existing authorized Telethon USER session. No interactive login at startup.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Existing file wins. Place Docker session files under ./data.
TELEGRAM_SESSION=/app/data/parlay.session
TELEGRAM_STRING_SESSION=
OPERATOR_ID=
COMMAND_PREFIX=/
LOG_LEVEL=INFO

# Optional AI voice. Music, rooms and Compass do not require Gemini.
GEMINI_API_KEY=
POT_PROVIDER_URL=http://127.0.0.1:4416
ACTIVITY_DB_PATH=data/parlay.sqlite3
MAX_CONCURRENT_CALLS=4

# Companion bot and room gateway. Leave BOT_TOKEN empty for userbot-only mode.
BOT_TOKEN=
BOT_SESSION=data/parlay-bot
BOT_DB_PATH=data/parlay-bot.sqlite3
BOT_USERNAME=
# Public HTTPS static frontend URL, registered as Main Mini App in BotFather.
MINI_APP_URL=
# Exact comma-separated frontend origins. Defaults to MINI_APP_URL origin.
ALLOWED_ORIGINS=
ROOM_DB_PATH=data/parlay-rooms.sqlite3
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8080

# Opt-in trainable recommendation engine.
ML_DB_PATH=data/parlay-ml.sqlite3
ML_MODEL_DIR=data/models
# Official YouTube Data API key for hourly music-chart discovery.
YOUTUBE_API_KEY=
